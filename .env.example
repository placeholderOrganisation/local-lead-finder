# Copy this file to .env and paste your key in.
#   cp .env.example .env
#
# Get a key at: https://console.cloud.google.com/  ->  APIs & Services
#   1. Create (or pick) a project
#   2. Enable the "Places API (New)"
#   3. Credentials -> Create credentials -> API key
#   4. (Recommended) Restrict the key to the "Places API (New)"
GOOGLE_PLACES_API_KEY=your-key-here

# ── CRM / engine config ───────────────────────────────────────────────────
# MongoDB Atlas connection string (master `leads` collection lives here).
# Create a free cluster at https://cloud.mongodb.com/ and copy the driver URI.
MONGODB_URI=your-mongodb-uri-here
# Database name to use inside the cluster.
MONGODB_DB=leadfinder
# Port the local dashboard HTTP server listens on.
PORT=4000

# ── Outreach generation (OpenAI) ──────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenRouter or any OpenAI-compatible base URL.
# OPENAI_BASE_URL=

# ── Worker quota guard ─────────────────────────────────────────────────────
# Soft monthly cap on Places API calls the background worker may spend.
MONTHLY_PLACES_CAP=4500

# ── Outreach personalization (used when composing pitch/email/script) ──────
# Your name, signed on outreach assets.
SENDER_NAME=
# The local area you serve (e.g. "Brampton, ON").
LOCAL_AREA=
# Link to your portfolio / past work.
PORTFOLIO_URL=
# Optional: booking link included in outreach (leave blank to omit).
CALENDAR_URL=

# ── Mockup hosting (Cloudflare R2, S3 API) ─────────────────────────────────
# Used by `publishMockup` (#43). Leave blank to skip publish (preview still works).
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket/custom domain, no trailing slash.
# Returned mockup URL is ${MOCKUP_PUBLIC_BASE}/{placeId}/index.html
MOCKUP_PUBLIC_BASE=
